# TCDD Ticket Finder Bot – example environment
# Copy to .env and fill with real values. Never commit .env.

TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_ALLOWED_USER_ID=your-telegram-user-id-here

TCDD_TOKEN=your-tcdd-token-here

# SQLite path: for Docker Compose must be /data/tcdd-ticket.sqlite3 (mounted named volume)
# For local development you may use data/tcdd-ticket.sqlite3
DATABASE_PATH=/data/tcdd-ticket.sqlite3

POLL_MIN_SECONDS=60
POLL_MAX_SECONDS=90

LOG_LEVEL=INFO
